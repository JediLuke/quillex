#!/usr/bin/env bash
# Play the Quillex demo: every feature, top to bottom, narrated by the editor
# into its own buffer.
#
#   scripts/run_demo          # paced to be watched
#   scripts/run_demo --fast   # same script, run as a regression test
#
# It is a spex, so it asserts as it goes. A demo that plays through while the
# feature underneath is broken would be worse than no demo at all.
set -euo pipefail
cd "$(dirname "$0")/.."

export PATH="$HOME/.asdf/shims:$HOME/.asdf/bin:$PATH"

DEMO_SPEED=watch
for arg in "$@"; do
  case "$arg" in
    --fast) DEMO_SPEED=fast ;;
    -h | --help)
      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "run_demo: unknown option $arg" >&2
      exit 2
      ;;
  esac
done
export DEMO_SPEED

if [ "$DEMO_SPEED" = watch ]; then
  echo "Playing the Quillex demo. It runs for a few minutes — watch the window."
  echo "(scripts/run_demo --fast runs the same script as a test.)"
  echo
fi

exec scripts/run_spex.sh test/spex/quillex/60_demo_spex.exs
