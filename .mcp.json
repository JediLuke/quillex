{
  "mcpServers": {
    "whiteboard": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "whiteboard-mcp"],
      "env": { "WHITEBOARD_MCP_LICENSE_KEY": "${WHITEBOARD_MCP_LICENSE_KEY:-}" }
    },
    "scenic-mcp": {
      "type": "stdio",
      "command": "bash",
      "args": ["tools/mcp/scenic_mcp.sh"]
    }
  }
}
