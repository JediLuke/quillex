#!/bin/sh
# Release boot environment. Mix generates this from rel/env.sh.eex.
#
# Mix releases start distributed by default, so that `bin/quillex remote` can
# attach to a running node. Distribution means epmd, and epmd means a process
# listening on 4369 for as long as the editor is open. A text editor should
# not be joining an Erlang cluster, and it should not be holding a port for
# the privilege — so: off.
#
# The cost is that `bin/quillex remote`, `rpc` and `eval --rpc` stop working.
# For a look inside a running editor, use `MIX_ENV=dev qlx`, which runs from
# source with the development tooling attached.
export RELEASE_DISTRIBUTION=none
